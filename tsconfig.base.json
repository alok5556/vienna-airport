{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "baseUrl": ".",
    "paths": {
      "@vienna/ui/*": ["packages/ui/src/*"],
      "@vienna/types": ["packages/types/src/index.ts"],
      "@vienna/config/*": ["packages/config/src/*"]
    }
  }
}
