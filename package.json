{
  "name": "vienna-airport-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @vienna/web & npm run dev --workspace @vienna/cms",
    "dev:web": "npm run dev --workspace @vienna/web",
    "dev:cms": "npm run dev --workspace @vienna/cms",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
