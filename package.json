{
  "name": "vienna-airport-platform",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20 <24",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter frontend --filter cms --filter vendure dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:cms": "pnpm --filter cms dev",
    "dev:vendure": "pnpm --filter vendure dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.12"
    }
  }
}
